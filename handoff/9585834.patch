+    <div style="max-width:1280px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
+        <div style="color:#9f1239;font-size:.9rem;font-weight:600;">
+            {{ rate_limit_message }}
+        </div>
+        <div style="display:flex;gap:10px;align-items:center;">
+            {% if payment_link_url %}
+                <a href="{{ payment_link_url }}?user={{ session.get('username','') }}" target="_blank" rel="noopener"
+                   style="text-decoration:none;background:#0a66c2;color:#fff;padding:6px 12px;border-radius:8px;font-size:.82rem;font-weight:700;">Upgrade</a>
+            {% else %}
+                <a href="/billing" style="text-decoration:none;background:#0a66c2;color:#fff;padding:6px 12px;border-radius:8px;font-size:.82rem;font-weight:700;">View Billing</a>
+            {% endif %}
+        </div>
+    </div>
+</div>
+{% else %}
+<div style="background:#eff6ff;border-bottom:1px solid #bfdbfe;padding:8px 24px;color:#1d4ed8;font-size:.82rem;">
+    <div style="max-width:1280px;margin:0 auto;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
+        <span>Plan: <strong style="text-transform:capitalize;">{{ usage_plan }}</strong></span>
+        <span>Daily searches: <strong>{{ usage_daily_count }}</strong> / <strong>{{ usage_daily_limit }}</strong></span>
+    </div>
+</div>
+{% endif %}
