+    function openLinkedInProfile() {
+        // Open in the same tab so user is not pushed into a new popup window.
+        window.location.href = 'https://www.linkedin.com/feed/';
+    }
+
+    function loadBillingSummary() {
+        const planEl = document.getElementById('billing-plan-status');
+        const alertEl = document.getElementById('billing-usage-alert');
+        if (!planEl || !alertEl) return;
+
+        planEl.textContent = '⏳ Loading...';
+        alertEl.textContent = 'Loading usage information...';
+
+        fetch('/api/usage-status', { credentials: 'same-origin' })
+            .then(r => {
+                if (!r.ok || r.redirected) {
+                    if (r.redirected) window.location.href = '/login';
+                    throw new Error('Unable to load usage');
+                }
+                return r.json();
+            })
+            .then(data => {
+                const plan = String(data.plan || 'free');
+                planEl.textContent = `${plan.toUpperCase()} plan`;
+                if (data.blocked) {
+                    alertEl.innerHTML = `⚠️ Daily limit reached: <strong>${data.daily_usage}/${data.daily_limit}</strong>. Upgrade to continue searching today.`;
+                } else {
+                    alertEl.innerHTML = `✅ Daily usage: <strong>${data.daily_usage}/${data.daily_limit}</strong>. Remaining today: <strong>${data.remaining}</strong>.`;
+                }
+            })
+            .catch(() => {
+                planEl.textContent = 'Error loading plan';
+                alertEl.textContent = 'Could not load billing usage. Please refresh.';
+            });
+    }
+
+    // ── Naukri account status ──────────────────────────────────────────────
+    function checkNaukriStatus() {
+        const statusEl = document.getElementById('naukri-status-text');
+        const card     = document.getElementById('naukri-card');
+        statusEl.textContent = '⏳ Checking…';
+        fetch('/api/naukri-status', { credentials: 'same-origin' })
+            .then(r => {
+                if (!r.ok || r.redirected) {
+                    if (r.redirected) window.location.href = '/login';
+                    throw new Error('Not authenticated');
+                }
+                return r.json();
+            })
+            .then(data => {
+                if (data.connected) {
+                    statusEl.textContent = '✅ Session Active';
+                    card.classList.add('connected');
+                    document.getElementById('naukri-setup-btn').textContent = '🔄 Re-Login';
+                } else {
+                    statusEl.textContent = '❌ Not logged in';
+                    card.classList.remove('connected');
+                    document.getElementById('naukri-setup-btn').textContent = '🔑 Setup Login';
+                }
+            })
+            .catch(err => {
+                if (String(err).includes('Not authenticated')) return;
+                statusEl.textContent = '⚠️ Could not check status';
+            });
+    }
+
+    function openNaukriLogin() {
+        const btn = document.getElementById('naukri-setup-btn');
+        btn.disabled = true;
+        btn.textContent = '⏳ Opening browser…';
+        fetch('/api/naukri-open-login', { method: 'POST', credentials: 'same-origin' })
+            .then(r => {
+                if (!r.ok || r.redirected) {
+                    btn.disabled = false;
+                    btn.textContent = '🔑 Setup Login';
+                    if (r.redirected) { window.location.href = '/login'; return; }
+                    return r.text().then(t => { throw new Error('Server error: ' + t.substring(0, 120)); });
+                }
+                return r.json();
+            })
+            .then(data => {
+                if (!data) return;
+                btn.disabled = false;
+                btn.textContent = '🔑 Setup Login';
+                if (data.status === 'launched') {
+                    const note = document.createElement('div');
+                    note.className = 'alert';
+                    note.style.marginTop = '10px';
+                    note.innerHTML = '🌐 <strong>Chrome opened.</strong> Log in to Naukri in that window, then close it. Click <strong>🔄 Refresh</strong> to confirm your session.';
+                    document.getElementById('naukri-card').insertAdjacentElement('afterend', note);
+                    setTimeout(() => note.remove(), 20000);
+                } else {
+                    alert('Failed to open browser: ' + (data.message || 'Unknown error'));
+                }
+            })
+            .catch(err => {
+                btn.disabled = false;
+                btn.textContent = '🔑 Setup Login';
+                alert('Error: ' + err);
+            });
+    }
+
     // Load saved settings on page load
     window.addEventListener('DOMContentLoaded', function() {
         const savedKey = localStorage.getItem('anthropic_api_key');
         if (savedKey) {
             document.getElementById('anthropic-key').value = savedKey;
         }
+        // Auto-check Naukri status
+        checkNaukriStatus();
+
+        // Open billing tab directly when arriving with #billing
+        if (window.location.hash === '#billing') {
+            switchTab('billing');
+        }
     });
 </script>
 
